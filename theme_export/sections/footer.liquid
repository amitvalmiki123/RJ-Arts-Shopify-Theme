{% comment %}
  RJ ARTS — Footer (design "FOOTER") — REPLACES Dawn's sections/footer.liquid

  Same approach as sections/header.liquid: the file keeps Dawn's name, section
  type ("footer") and schema shape, so sections/footer-group.json needs no
  custom section type and the editor still shows exactly ONE footer.

  Dawn's own footer markup could not produce this layout (newsletter band split 1fr/1fr,
  4-column brand/menus grid, payment chips row, ghost wordmark), so this is a
  dedicated section used by sections/footer-group.json.

  Matches design/THE-RJ-ARTS.html:
    .footer            ink panel, 1px brass gradient hairline at the very top,
                       rgba(255,255,255,.65) body text
    .footer__news      1fr / 1fr, 40px gap, 58px block padding, hairline below;
                       serif clamp(28,3vw,44) white heading, 14px copy, and a
                       bordered form (radius 2) with a brass Subscribe button
    .footer__grid      1.7fr / 1fr / 1fr / 1.2fr, 48px gap, 64/52 padding;
                       logo inverted to white at 30px, 14px copy max 300,
                       contact links with brass 17px icons, brass h5 labels
                       11px/.2em, list links that slide 6px on hover
    .footer__socials   40px circles, 1px rgba(255,255,255,.18), brass on hover
    .footer__pay       "We accept" + chips (real enabled payment icons)
    .footer__bottom    hairline top, 12.5px, 24/30 padding
    .footer__ghost     serif clamp(84px,19vw,290px), rgba(255,255,255,.035)

  Newsletter is a real Shopify customer form (tags: newsletter), so sign-ups
  land in Customers → Subscribers.
{% endcomment %}

{%- liquid
  assign rj_brand = section.settings.brand_image | default: settings.logo
  assign rj_social_count = 0
  if section.settings.social_instagram != blank
    assign rj_social_count = rj_social_count | plus: 1
  endif
  if section.settings.social_facebook != blank
    assign rj_social_count = rj_social_count | plus: 1
  endif
  if section.settings.social_pinterest != blank
    assign rj_social_count = rj_social_count | plus: 1
  endif
  if section.settings.social_youtube != blank
    assign rj_social_count = rj_social_count | plus: 1
  endif
-%}

<footer
  class="rj-footer color-{{ section.settings.color_scheme }} gradient"
  style="--rj-foot-pt: {{ section.settings.padding_top }}px;"
>
  <div class="rj-wrap">

    {%- if section.settings.show_newsletter -%}
      <div class="rj-footer__news rj-reveal">
        <div class="rj-footer__news-copy">
          {%- if section.settings.newsletter_eyebrow != blank -%}
            <span class="rj-eyebrow rj-footer__news-eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.newsletter_heading != blank -%}
            <h3 class="rj-footer__news-title">{{ section.settings.newsletter_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <p class="rj-footer__news-text">{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}
        </div>

        <div class="rj-footer__news-form">
          {%- form 'customer', id: 'RjFooterNewsletter', class: 'rj-newsform' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="rj-visually-hidden" for="RjFooterEmail-{{ section.id }}">
              {{ section.settings.newsletter_placeholder | default: 'Email address' }}
            </label>
            <input
              id="RjFooterEmail-{{ section.id }}"
              class="rj-newsform__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.newsletter_placeholder | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="RjFooterError-{{ section.id }}"{% endif %}
            >
            <button class="rj-newsform__btn" type="submit" name="commit">
              {{- section.settings.newsletter_button | escape -}}
            </button>
          {%- endform -%}

          {%- if form.posted_successfully? -%}
            <p class="rj-newsform__msg" id="RjFooterSuccess-{{ section.id }}" tabindex="-1">
              {{ section.settings.newsletter_success | escape }}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="rj-newsform__msg rj-newsform__msg--error" id="RjFooterError-{{ section.id }}">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="rj-footer__grid">
      <div class="rj-footer__brand">
        {%- if rj_brand != blank -%}
          <div class="rj-footer__logo">
            {{
              rj_brand
              | image_url: width: 400
              | image_tag: loading: 'lazy', widths: '120,200,300,400', sizes: '160px', class: 'rj-footer__logo-img', alt: shop.name
            }}
          </div>
        {%- else -%}
          <div class="rj-footer__wordmark">{{ shop.name }}</div>
        {%- endif -%}

        {%- if section.settings.brand_text != blank -%}
          <div class="rj-footer__brand-text">{{ section.settings.brand_text }}</div>
        {%- endif -%}

        {%- if section.settings.email != blank or section.settings.phone != blank -%}
          <div class="rj-footer__contact">
            {%- if section.settings.email != blank -%}
              <a href="mailto:{{ section.settings.email }}">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                {{ section.settings.email | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.phone != blank -%}
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h3l2 5-3 2a12 12 0 0 0 6 6l2-3 5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg>
                {{ section.settings.phone | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if rj_social_count > 0 -%}
          <div class="rj-footer__socials">
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 3h-3a4 4 0 0 0-4 4v3H5v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_pinterest != blank -%}
              <a href="{{ section.settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7c-2 0-3.5 1.4-3.5 3.3 0 .9.5 1.8 1.2 2M12 7c2 0 3.5 1.4 3.5 3.5S14 14 12.5 14c-1 0-1.7-.7-1.5-1.6l.6-3M10 17l1-4"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <a href="{{ section.settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="6" width="19" height="12" rx="3.5"/><polygon points="10 9.5 15 12 10 14.5" fill="currentColor" stroke="none"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="rj-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h5 class="rj-footer__hd">{{ block.settings.heading | escape }}</h5>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="rj-footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <ul class="rj-footer__links rj-footer__links--empty">
                  <li><a href="#">Add a menu</a></li>
                </ul>
              {%- endif -%}

              {%- if block.settings.show_payment -%}
                <div class="rj-footer__pay">
                  <span>{{ section.settings.payment_label | escape }}</span>
                  {%- if shop.enabled_payment_types.size > 0 -%}
                    {%- for type in shop.enabled_payment_types -%}
                      <span class="rj-footer__chip rj-footer__chip--icon">{{ type | payment_type_svg_tag }}</span>
                    {%- endfor -%}
                  {%- else -%}
                    {%- assign chips = section.settings.payment_chips | split: ',' -%}
                    {%- for chip in chips -%}
                      <span class="rj-footer__chip">{{ chip | strip | escape }}</span>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="rj-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h5 class="rj-footer__hd">{{ block.settings.heading | escape }}</h5>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rj-footer__brand-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="rj-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright | escape }}</span>
      {%- if section.settings.credit != blank -%}
        <span>{{ section.settings.credit | escape }}</span>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_ghost -%}
    <div class="rj-footer__ghost" aria-hidden="true">{{ section.settings.ghost_text | escape }}</div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "rj-footer-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Design uses the ink scheme.",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Newsletter band"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter band",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Eyebrow",
      "default": "The Inner Circle"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the list. Get 10% off your first order."
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Text",
      "default": "Be first to see new editions and limited pieces, get invitations to private design events, and enjoy members-only offers and styling tips — straight to your inbox."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thanks — welcome to the Inner Circle."
    },
    {
      "type": "header",
      "content": "Brand column"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Logo override",
      "info": "Leave empty to use the Theme settings logo."
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand text",
      "default": "<p>Handcrafted solid Sheesham furniture for the modern Indian home — loved by over 10,000 happy homes and 1,000+ five-star reviews.</p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "care@therjart.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91 70144 83250"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "header",
      "content": "Payment + bottom"
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Payment label",
      "default": "We accept"
    },
    {
      "type": "text",
      "id": "payment_chips",
      "label": "Fallback chips",
      "info": "Comma separated. Only used when the store has no enabled payment methods.",
      "default": "UPI, Visa, Mastercard, EMI"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Credit line",
      "default": "Crafted with care · Designed by AWA"
    },
    {
      "type": "checkbox",
      "id": "show_ghost",
      "label": "Show the ghost wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "ghost_text",
      "label": "Ghost wordmark text",
      "default": "RJ ARTS"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "info": "Design value: 0px (the newsletter band carries its own padding).",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "checkbox",
          "id": "show_payment",
          "label": "Show payment chips under this column",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop", "show_payment": false } },
        { "type": "menu", "settings": { "heading": "Company", "show_payment": false } },
        { "type": "menu", "settings": { "heading": "Support", "show_payment": true } }
      ]
    }
  ]
}
{% endschema %}
