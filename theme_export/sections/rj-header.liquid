{% comment %}
  RJ ARTS — header (design .header / .nav / .mega)

  Built for Dawn 16.x (Shopify currently ships 16.1.0). If you run an older Dawn,
  remove the `show_country_selector` / `show_language_selector` / `show_social_links`
  arguments from the `header-drawer` render below.
  Matches design/THE-RJ-ARTS.html: 82px sticky bar, blurred cream, logo left,
  uppercase nav with hover mega panels (2 link columns + 2 image cards),
  search / account / cart on the right.
  Keeps Dawn's native cart drawer, search modal and mobile drawer behaviour.
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{% style %}
  .rj-logo img {
    max-height: {{ section.settings.logo_height }}px;
    height: {{ section.settings.logo_height }}px;
  }
  {%- unless section.settings.enable_sticky -%}
    .shopify-section.rj-site-header {
      position: static;
    }
  {%- endunless -%}
{% endstyle %}

<div class="rj-header-wrap header-wrapper color-{{ section.settings.color_scheme }} gradient" data-rj-header>
  <div class="rj-wrap">
    <nav class="rj-nav" aria-label="{{ 'sections.header.menu' | t | default: 'Primary' }}">
      {%- if section.settings.menu != blank -%}
        {%- comment -%}
          Dawn 16.x: header-drawer takes explicit selector flags. Country/language
          selectors live in the icon row, social links are not in the design.
        {%- endcomment -%}
        {%- render 'header-drawer',
          show_country_selector: false,
          show_language_selector: false,
          show_social_links: false
        -%}
      {%- endif -%}

      <a href="{{ routes.root_url }}" class="rj-logo">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'rj-logo__img',
              widths: '120, 200, 300, 400, 600',
              sizes: '200px',
              alt: logo_alt,
              preload: true
          }}
        {%- else -%}
          <span class="rj-logo__text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- if section.settings.menu != blank -%}
        <ul class="rj-nav__menu">
          {%- for link in section.settings.menu.links -%}
            {%- assign mega_block = nil -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'mega_menu' and block.settings.parent_link == link.title -%}
                {%- assign mega_block = block -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- liquid
              assign has_cards = false
              if mega_block != nil
                if mega_block.settings.card_1_image != blank or mega_block.settings.card_1_label != blank or mega_block.settings.card_2_image != blank or mega_block.settings.card_2_label != blank
                  assign has_cards = true
                endif
              endif

              assign has_col_2 = false
              if mega_block != nil
                if mega_block.settings.menu_2 != blank or mega_block.settings.menu_2_heading != blank
                  assign has_col_2 = true
                endif
              endif

              assign mega_classes = ''
              if has_cards == false
                if has_col_2
                  assign mega_classes = ' rj-mega--no-feature'
                else
                  assign mega_classes = ' rj-mega--one-col'
                endif
              endif
            -%}

            <li class="rj-nav__item{% if link.links != blank or mega_block != nil %} rj-nav__item--has-panel{% endif %}">
              <a
                href="{{ link.url }}"
                class="rj-nav__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title | escape }}
                {%- if link.links != blank or mega_block != nil -%}
                  <i class="rj-chev" aria-hidden="true"></i>
                {%- endif -%}
              </a>

              {%- if mega_block != nil -%}
                <div class="rj-mega{{ mega_classes }}" {{ mega_block.shopify_attributes }}>
                  <div>
                    {%- if mega_block.settings.menu_1_heading != blank -%}
                      <h4>{{ mega_block.settings.menu_1_heading }}</h4>
                    {%- endif -%}
                    <ul>
                      {%- if mega_block.settings.menu_1 != blank -%}
                        {%- for child in mega_block.settings.menu_1.links -%}
                          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endfor -%}
                      {%- else -%}
                        {%- for child in link.links -%}
                          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endfor -%}
                      {%- endif -%}
                    </ul>
                  </div>

                  {%- if has_col_2 -%}
                    <div>
                      {%- if mega_block.settings.menu_2_heading != blank -%}
                        <h4>{{ mega_block.settings.menu_2_heading }}</h4>
                      {%- endif -%}
                      <ul>
                        {%- for child in mega_block.settings.menu_2.links -%}
                          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}

                  {%- if has_cards -%}
                    <div class="rj-mega__feature">
                      {%- for i in (1..2) -%}
                        {%- liquid
                          case i
                            when 1
                              assign card_image = mega_block.settings.card_1_image
                              assign card_label = mega_block.settings.card_1_label
                              assign card_link = mega_block.settings.card_1_link
                            when 2
                              assign card_image = mega_block.settings.card_2_image
                              assign card_label = mega_block.settings.card_2_label
                              assign card_link = mega_block.settings.card_2_link
                          endcase
                        -%}
                        {%- if card_image != blank or card_label != blank -%}
                          <a class="rj-mega__card" href="{{ card_link | default: link.url }}">
                            {%- if card_image != blank -%}
                              {{
                                card_image
                                | image_url: width: 800
                                | image_tag:
                                  widths: '300, 500, 700, 800',
                                  sizes: '(min-width: 990px) 260px, 40vw',
                                  loading: 'lazy',
                                  alt: card_label
                              }}
                            {%- endif -%}
                            {%- if card_label != blank -%}
                              <span>{{ card_label }}</span>
                            {%- endif -%}
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- elsif link.links != blank -%}
                <div class="rj-mega rj-mega--one-col">
                  {%- if link.links.first.links != blank -%}
                    <div>
                      <h4>{{ link.title }}</h4>
                      <ul>
                        {%- for child in link.links -%}
                          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- else -%}
                    <ul>
                      {%- for child in link.links -%}
                        <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="rj-nav__actions">
        {% render 'header-search', input_id: 'Search-In-Modal' %}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="rj-icon-btn rj-icon-btn--account"
            rel="nofollow"
            aria-label="{{ 'customer.log_in' | t | default: 'Account' }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>
            </svg>
          </a>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="rj-icon-btn rj-icon-btn--cart"
          id="cart-icon-bubble"
          aria-label="{{ 'templates.cart.cart' | t | default: 'Cart' }}"
        >
          {%- render 'rj-cart-icon' -%}
        </a>
      </div>
    </nav>
  </div>
</div>

{% javascript %}
  (function () {
    const header = document.querySelector('[data-rj-header]');
    if (!header) return;
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 30);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "RJ header",
  "class": "section-header rj-site-header",
  "max_blocks": 6,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Logo height",
      "info": "Design value: 26px.",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "menu_color_scheme",
      "label": "Mobile drawer colour scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu panel",
      "settings": [
        {
          "type": "text",
          "id": "parent_link",
          "label": "Parent menu item title",
          "info": "Must match a top-level menu item exactly, e.g. Bedroom.",
          "default": "Bedroom"
        },
        {
          "type": "header",
          "content": "Column 1"
        },
        {
          "type": "text",
          "id": "menu_1_heading",
          "label": "Heading",
          "default": "Beds"
        },
        {
          "type": "link_list",
          "id": "menu_1",
          "label": "Menu"
        },
        {
          "type": "header",
          "content": "Column 2"
        },
        {
          "type": "text",
          "id": "menu_2_heading",
          "label": "Heading",
          "default": "Bedroom Storage"
        },
        {
          "type": "link_list",
          "id": "menu_2",
          "label": "Menu"
        },
        {
          "type": "header",
          "content": "Feature cards"
        },
        {
          "type": "image_picker",
          "id": "card_1_image",
          "label": "Card 1 image"
        },
        {
          "type": "text",
          "id": "card_1_label",
          "label": "Card 1 label",
          "default": "Sheesham Beds"
        },
        {
          "type": "url",
          "id": "card_1_link",
          "label": "Card 1 link"
        },
        {
          "type": "image_picker",
          "id": "card_2_image",
          "label": "Card 2 image"
        },
        {
          "type": "text",
          "id": "card_2_label",
          "label": "Card 2 label",
          "default": "Brass Heritage"
        },
        {
          "type": "url",
          "id": "card_2_link",
          "label": "Card 2 link"
        }
      ]
    }
  ]
}
{% endschema %}
