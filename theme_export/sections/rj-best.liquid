{% comment %}
  RJ ARTS — Best sellers grid (design "BEST SELLERS — ASYMMETRICAL GRID", #best)

  Matches design/THE-RJ-ARTS.html:
    .sec-head         eyebrow + h2 left, outline button right
    .pgrid            4 equal columns, 22px gap
    .pcard            white card, hairline border, 4px radius, lift on hover
    .pcard__tag.sale  rust badge showing the discount (-46%)
    .pcard__price     now / struck-through compare-at (no % chip here — the
                      badge already carries it, exactly like the design)
    .pcard__stars     brass stars + review label

  Products come from a collection, so price, compare-at, type and image are
  live. Empty collection → placeholder cards.

  Usage: {% section 'rj-best' %}
{% endcomment %}

{%- liquid
  assign rj_collection = section.settings.collection
  assign rj_count = section.settings.products_to_show
-%}

<div
  class="rj-best color-{{ section.settings.color_scheme }} gradient"
  style="--rj-best-pt: {{ section.settings.padding_top }}px; --rj-best-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="rj-wrap">
    <div class="rj-best__head rj-reveal">
      <div class="rj-best__head-main">
        {%- if section.settings.eyebrow != blank -%}
          <span class="rj-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rj-best__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.link_label != blank -%}
        <a class="rj-btn rj-best__viewall" href="{{ section.settings.link | default: rj_collection.url }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <div class="rj-best__grid rj-reveal">
      {%- if rj_collection != blank and rj_collection.products_count > 0 -%}
        {%- for product in rj_collection.products limit: rj_count -%}
          {%- liquid
            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
            endif
            assign discount = 0
            if on_sale
              assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
            endif
          -%}
          <article class="rj-pcard">
            <div class="rj-pcard__media">
              {%- if on_sale -%}
                <span class="rj-pcard__tag is-sale">&minus;{{ discount }}%</span>
              {%- elsif product.tags contains 'Best Sellers' -%}
                <span class="rj-pcard__tag">{{ section.settings.best_badge | default: 'Best Seller' }}</span>
              {%- endif -%}
              <a class="rj-pcard__link" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 700 | image_tag:
                      loading: 'lazy',
                      widths: '300,400,500,700',
                      sizes: '(min-width: 990px) 23vw, 45vw',
                      class: 'rj-pcard__img',
                      alt: product.title
                  }}
                {%- else -%}
                  {{ 'product-2' | placeholder_svg_tag: 'rj-pcard__img rj-pcard__img--placeholder' }}
                {%- endif -%}
              </a>
              <div class="rj-pcard__quick">
                <a class="rj-btn rj-btn--light" href="{{ product.url }}">
                  {{ section.settings.quick_view_label | escape }}
                </a>
              </div>
            </div>
            <div class="rj-pcard__body">
              {%- if product.type != blank -%}
                <span class="rj-pcard__cat">{{ product.type | escape }}</span>
              {%- endif -%}
              <h3 class="rj-pcard__title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
              <div class="rj-pcard__price">
                <span class="now">{{ product.price | money }}</span>
                {%- if on_sale -%}
                  <span class="was">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <div class="rj-pcard__stars">
                <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                <small>{{ section.settings.rating_label | escape }}</small>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="rj-pcard">
            <div class="rj-pcard__media">
              <span class="rj-pcard__tag{% cycle '', ' is-sale' %}">{% cycle 'Best Seller', '−42%' %}</span>
              <div class="rj-pcard__placeholder">
                {{ 'product-' | append: i | placeholder_svg_tag: 'rj-pcard__img rj-pcard__img--placeholder' }}
              </div>
              <div class="rj-pcard__quick">
                <span class="rj-btn rj-btn--light">{{ section.settings.quick_view_label | escape }}</span>
              </div>
            </div>
            <div class="rj-pcard__body">
              <span class="rj-pcard__cat">Bedroom</span>
              <h3 class="rj-pcard__title">Example best seller</h3>
              <div class="rj-pcard__price">
                <span class="now">₹0</span>
              </div>
              <div class="rj-pcard__stars">
                <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                <small>{{ section.settings.rating_label | escape }}</small>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "RJ Best sellers",
  "tag": "section",
  "class": "rj-best-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Loved Most"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This week's best sellers."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Design shows 4 products. Pick a Best Sellers collection here."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "best_badge",
      "label": "Badge for “Best Sellers” tag",
      "default": "Best Seller"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Text under the stars",
      "default": "Best Seller",
      "info": "Live review counts need a reviews app."
    },
    {
      "type": "text",
      "id": "quick_view_label",
      "label": "Card button label",
      "default": "Quick View"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Top-right button label",
      "default": "View All Best Sellers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Top-right button link",
      "info": "Defaults to the collection picked above."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "RJ Best sellers",
      "settings": {
        "eyebrow": "Loved Most",
        "heading": "This week's best sellers.",
        "products_to_show": 4,
        "link_label": "View All Best Sellers",
        "rating_label": "Best Seller"
      }
    }
  ]
}
{% endschema %}
