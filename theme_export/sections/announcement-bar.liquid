{% comment %}
  RJ ARTS — announcement bar (design .announce)
  Dawn file, merged: same schema IDs as upstream (color_scheme, show_line_separator,
  show_social, auto_rotate, change_slides_speed, enable/language selectors) so
  header-group.json keeps working, plus marquee controls.
  Design: ink strip, 12px uppercase .16em, brass bold, star separators, 34s loop.
{% endcomment %}

{%- liquid
  assign msg_count = section.blocks.size
  assign marquee = section.settings.enable_marquee
  if marquee == false or msg_count < 2
    assign marquee = false
  endif
-%}

{%- if msg_count > 0 -%}
  <div
    class="utility-bar color-{{ section.settings.color_scheme }} gradient rj-announce-bar{% if section.settings.show_line_separator %} utility-bar--bottom-border{% endif %}{% unless marquee %} rj-announce-bar--static{% endunless %}"
    style="--rj-marquee-duration: {{ section.settings.marquee_speed }}s;"
  >
    <div
      class="rj-ticker"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
    >
      {%- if marquee -%}
        {%- for copy in (1..2) -%}
          <div class="rj-ticker__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- if section.settings.show_star -%}
                <i class="rj-ticker__star" aria-hidden="true"></i>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="rj-ticker__msg" {{ block.shopify_attributes }}>
                  {{- block.settings.text -}}
                </a>
              {%- else -%}
                <span class="rj-ticker__msg" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="rj-ticker__group rj-ticker__group--static">
          {%- for block in section.blocks -%}
            {%- if section.settings.show_star and forloop.index0 > 0 -%}
              <i class="rj-ticker__star" aria-hidden="true"></i>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="rj-ticker__msg" {{ block.shopify_attributes }}>
                {{- block.settings.text -}}
              </a>
            {%- else -%}
              <span class="rj-ticker__msg" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "announcement-bar-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Scrolling ticker",
      "info": "Design uses a continuous loop. Off = all messages sit in one static row.",
      "default": true
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Ticker loop duration",
      "info": "Design value: 34s.",
      "default": 34
    },
    {
      "type": "checkbox",
      "id": "show_star",
      "label": "Show star separators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Show line separator",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false,
      "info": "Kept for compatibility; the ticker runs on 'Ticker loop duration'."
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 6
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "default": false
    },
    {
      "type": "header",
      "content": "Country / region"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label",
          "info": "Bold text renders in brass, as in the design.",
          "default": "10% off for registered members"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "announcement", "settings": { "text": "<strong>10%</strong> off for registered members" } },
      { "type": "announcement", "settings": { "text": "Over <strong>10,000</strong> happy customers" } },
      { "type": "announcement", "settings": { "text": "<strong>1,000+</strong> five-star reviews" } },
      { "type": "announcement", "settings": { "text": "<strong>0%</strong> finance available" } },
      { "type": "announcement", "settings": { "text": "Free delivery on solid-wood beds" } }
    ]
  }
}
{% endschema %}
