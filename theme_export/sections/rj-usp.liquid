{% comment %}
  RJ ARTS — USP strip (design .usp)

  Matches design/THE-RJ-ARTS.html: hairline-bottomed trust row, 4 equal columns,
  30px vertical padding, 26px brass 1.3px-stroke icons, 14px/500 heading with a
  12.5px grey line under it. Two columns from 768px down.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <div
    class="rj-usp color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line %} rj-usp--line{% endif %}"
    style="--rj-usp-pad: {{ section.settings.padding_y }}px;"
  >
    <div class="rj-wrap">
      <div class="rj-usp__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign delay = forloop.index0 | at_most: 4
            assign delay_class = ''
            if delay > 0
              assign delay_class = ' d' | append: delay
            endif
          -%}
          <div class="rj-usp__item rj-reveal{{ delay_class }}" {{ block.shopify_attributes }}>
            <span class="rj-usp__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M12 2l2.5 5 5.5.8-4 3.9.9 5.5L12 20l-4.9 2.6.9-5.5-4-3.9 5.5-.8z"/>
                  </svg>
                {%- when 'wood' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4"/><path d="M12 11v10"/>
                  </svg>
                {%- when 'warranty' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M4 12a8 8 0 0 1 16 0"/><path d="M12 4v4M12 12l3 2"/>
                  </svg>
                {%- when 'finance' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/>
                  </svg>
                {%- when 'delivery' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z"/><path d="M9 12l2 2 4-4"/>
                  </svg>
              {%- endcase -%}
            </span>
            <div class="rj-usp__text">
              {%- if block.settings.heading != blank -%}
                <b>{{ block.settings.heading }}</b>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <small>{{ block.settings.text }}</small>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "RJ USP strip",
  "tag": "section",
  "class": "rj-usp-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Top & bottom padding",
      "info": "Design value: 30px.",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_line",
      "label": "Show hairline under the strip",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "USP item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "star", "label": "Star (reviews)" },
            { "value": "wood", "label": "Solid wood cube" },
            { "value": "warranty", "label": "Warranty arc" },
            { "value": "finance", "label": "Finance card" },
            { "value": "delivery", "label": "Delivery van" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "1,000+ 5-Star Reviews"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Sub-line",
          "default": "Loved by 10,000+ homes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RJ USP strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "star", "heading": "1,000+ 5-Star Reviews", "text": "Loved by 10,000+ homes" } },
        { "type": "item", "settings": { "icon": "wood", "heading": "100% Solid Sheesham", "text": "Kiln-dried, hand-finished" } },
        { "type": "item", "settings": { "icon": "warranty", "heading": "3-Year Warranty", "text": "Built to be handed down" } },
        { "type": "item", "settings": { "icon": "finance", "heading": "0% Finance Available", "text": "Easy EMI at checkout" } }
      ]
    }
  ]
}
{% endschema %}
