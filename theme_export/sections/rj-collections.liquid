{% comment %}
  RJ ARTS — Collection carousel (design "HORIZONTAL COLLECTION CAROUSEL")

  Matches design/THE-RJ-ARTS.html:
    .sec-head   eyebrow + h2 left, round arrow pair right
    .rail       horizontal snap rail, cards min 240px, 22px gap, brass bar
    .pcard      square image, small ink tag (series name), brass category line,
                serif 20px title, price line

  One block = one collection. Card data:
    image   → collection.featured_image
    tag     → "Series / tag" setting (falls back to collection title)
    cat     → "Category line" setting (e.g. Storage, Lounge, Dining)
    title   → collection title (overridable)
    price   → "From <cheapest product price>" when the setting is on

  Usage: {% section 'rj-collections' %}
{% endcomment %}

<rj-carousel
  class="rj-edit color-{{ section.settings.color_scheme }} gradient"
  style="--rj-edit-pt: {{ section.settings.padding_top }}px; --rj-edit-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="rj-wrap">
    <div class="rj-edit__head rj-reveal">
      <div class="rj-edit__head-main">
        {%- if section.settings.eyebrow != blank -%}
          <span class="rj-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rj-edit__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="rj-railnav">
          <button type="button" data-rj-rail-dir="-1" aria-label="Previous">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polyline points="15 5 8 12 15 19"/></svg>
          </button>
          <button type="button" data-rj-rail-dir="1" aria-label="Next">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polyline points="9 5 16 12 9 19"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="rj-rail rj-edit__rail rj-reveal" data-rj-rail>
      {%- for block in section.blocks -%}
        {%- liquid
          assign rj_collection = block.settings.collection
          assign rj_image = block.settings.image | default: rj_collection.featured_image
          assign rj_title = block.settings.title | default: rj_collection.title
          assign rj_tag = block.settings.tag | default: rj_collection.title
          assign rj_link = block.settings.link | default: rj_collection.url
        -%}
        <article class="rj-pcard rj-pcard--edit" {{ block.shopify_attributes }}>
          <div class="rj-pcard__media">
            {%- if rj_tag != blank -%}
              <span class="rj-pcard__tag">{{ rj_tag | escape }}</span>
            {%- endif -%}
            <a class="rj-pcard__link" href="{{ rj_link | default: '#' }}" tabindex="-1" aria-hidden="true">
              {%- if rj_image != blank -%}
                {{ rj_image | image_url: width: 700 | image_tag:
                    loading: 'lazy',
                    widths: '300,400,500,700',
                    sizes: '(min-width: 990px) 260px, 70vw',
                    class: 'rj-pcard__img',
                    alt: rj_title
                }}
              {%- else -%}
                {{ 'collection-2' | placeholder_svg_tag: 'rj-pcard__img rj-pcard__img--placeholder' }}
              {%- endif -%}
            </a>
          </div>
          <div class="rj-pcard__body">
            {%- if block.settings.category != blank -%}
              <span class="rj-pcard__cat">{{ block.settings.category | escape }}</span>
            {%- endif -%}
            <h3 class="rj-pcard__title">
              <a href="{{ rj_link | default: '#' }}">{{ rj_title | default: 'Collection' }}</a>
            </h3>
            {%- if block.settings.show_price and rj_collection.products_count > 0 -%}
              <div class="rj-pcard__price">
                <span class="now">
                  {{ section.settings.price_prefix | escape }}
                  {{ rj_collection.products.first.price | money }}
                </span>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</rj-carousel>

{% schema %}
{
  "name": "RJ Collection carousel",
  "tag": "section",
  "class": "rj-edit-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Latest Editions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh from the workshop."
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From",
      "info": "Shown before the collection's cheapest product price."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Its image, title and link are used automatically."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional, overrides the collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Small image tag",
          "info": "Design shows the series name here (Sevilla, Crew, Simons…)."
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category line",
          "info": "Small brass line above the title, e.g. Storage, Lounge, Dining."
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show “From” price",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RJ Collection carousel",
      "blocks": [
        { "type": "card", "settings": { "tag": "Sevilla", "category": "Storage" } },
        { "type": "card", "settings": { "tag": "Crew", "category": "Lounge" } },
        { "type": "card", "settings": { "tag": "Simons", "category": "Single" } },
        { "type": "card", "settings": { "tag": "Scott", "category": "Crafted" } },
        { "type": "card", "settings": { "tag": "Arvyn", "category": "Dining" } },
        { "type": "card", "settings": { "tag": "Bar", "category": "Living" } }
      ]
    }
  ]
}
{% endschema %}
