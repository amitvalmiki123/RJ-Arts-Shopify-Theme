{% comment %}
  RJ ARTS — announcement marquee (design .announce)
  Matches design/THE-RJ-ARTS.html: dark ink strip, 12px uppercase, brass highlights,
  star separators, 34s loop.
{% endcomment %}
{%- if section.blocks.size > 0 -%}
  <div class="rj-announce color-{{ section.settings.color_scheme }} gradient" role="region" aria-label="{{ 'sections.header.announcement' | t | default: 'Announcement' }}">
    <div
      class="rj-announce__track"
      style="--rj-marquee-duration: {{ section.settings.speed }}s; font-size: {{ section.settings.font_size }}px;"
    >
      {%- for copy in (1..2) -%}
        <span class="rj-announce__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- if section.settings.show_star -%}
              <i class="rj-announce__star" aria-hidden="true"></i>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
            {%- else -%}
              <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "RJ announcement bar",
  "class": "rj-announcement-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme (ink strip)",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 12
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Marquee loop speed",
      "info": "One full loop. Design value: 34s.",
      "default": 34
    },
    {
      "type": "checkbox",
      "id": "show_star",
      "label": "Show brass star separators",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Message",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "info": "Bold text is rendered in brass, like the design.",
          "default": "10% off for registered members"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RJ announcement bar",
      "blocks": [
        { "type": "text", "settings": { "text": "<strong>10%</strong> off for registered members" } },
        { "type": "text", "settings": { "text": "Over <strong>10,000</strong> happy customers" } },
        { "type": "text", "settings": { "text": "<strong>1,000+</strong> five-star reviews" } },
        { "type": "text", "settings": { "text": "<strong>0%</strong> finance available" } },
        { "type": "text", "settings": { "text": "Free delivery on solid-wood beds" } }
      ]
    }
  ]
}
{% endschema %}
